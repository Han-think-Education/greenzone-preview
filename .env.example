# GreenZone Preview - 실제 값은 이 파일이 아니라 본인 .env에 넣으세요.
# 시작: .env가 없을 때만 이 파일을 .env로 복사 → 필요한 항목만 편집 → 저장
# 설명/신청 절차: README.md / docs/ENV_REFERENCE.md
# 기본 웹은 API 키·Ollama 없이 포함된 분석 결과와 품목·문서 파일로 동작합니다.
# 실제 .env는 Git에서 제외됩니다. 기존 .env는 덮어쓰지 마세요.

# 1. 기본 웹 / 관리자
APP_ENV=development
# 브라우저 접속 포트. 바꾸면 localhost 주소의 포트도 바꿉니다.
APP_PORT=8000
ADMIN_USERNAME=admin
# 관리 기능을 쓸 때 본인이 직접 정하는 12자 이상 암호. API 발급키가 아닙니다.
# 비워 두면 Docker에서 관리자 로그인은 불가. 일반 지도·안내는 사용 가능.
ADMIN_PASSWORD=

# 2. 선택: VWorld 위성·항공 / 영상+도로명
# 신청: https://www.vworld.kr/ → 로그인 → 오픈API 인증키 발급/관리
# 권한: WMTS/TMS API. 발급값: VWorld 오픈API 인증키(공공데이터포털 키와 다름)
# 실제 등록 서비스 주소·로컬 URL 허용 조건·유효기간은 신청 화면에서 확인.
# 입력 후 docker compose up -d --build web 으로 반영.
VWORLD_API_KEY=
# 선택: 등록된 실제 서비스 URL. 예: http://localhost:8000/
# 비우면 현재 웹 기본 주소 사용. 이 값으로 키 권한이 변경되지는 않습니다.
VWORLD_DOMAIN=

# 3. 선택: Ollama 질문 분류(대화 모델)
# 로컬 모델 서버는 별도 실행. API 키를 발급받는 설정이 아닙니다.
# Docker 웹 → 호스트 Ollama: host.docker.internal:11434
# 직접 Python 실행: http://127.0.0.1:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
GREENZONE_AI_ENABLED=0
# ollama list에 표시된 설치 대화 모델의 정확한 이름. BGE-M3를 여기에 넣지 않습니다.
# 분류를 쓰지 않을 때는 빈칸 유지. 실제 대화 모델명을 넣은 뒤 위 스위치를 1로 바꿉니다.
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=45

# 4. 선택: BGE-M3 공식 안내문 의미 검색 - 질문 분류와 별개
# 설치/모델: https://ollama.com/download / https://ollama.com/library/bge-m3
# 설치 목록 확인: ollama list / 없고 사용하려는 경우에만: ollama pull bge-m3
# 의미 검색을 쓸 때 1. 0이면 키워드 검색 사용.
GREENZONE_EMBEDDING_ENABLED=0
EMBEDDING_MODEL=bge-m3:latest
# 비우면 위 OLLAMA_BASE_URL 재사용. 별도 임베딩 서버가 있을 때만 입력.
EMBEDDING_OLLAMA_BASE_URL=
# 앱 허용 범위 1~60초. 첫 모델 로딩을 감안한 예제값.
EMBEDDING_TIMEOUT_SECONDS=60
# 유사도 기준은 정답 확률이 아닙니다. 실제 질의로 조정합니다.
EMBEDDING_MIN_SCORE=0.55
# 모델 버전·양자화를 바꾸면 올리고 재색인합니다.
EMBEDDING_REVISION=1
# 스위치 1과 서버/모델 준비 → 웹 반영 → 아래 명령을 명시적으로 실행해야 벡터 생성
# docker compose exec web python -m scripts.index_knowledge --embed
# 이 명령은 실제 모델을 호출합니다. '안내문 등록'과 '색인 완료'는 다릅니다.

# 5. 후속 분석 자료 수집용 준비 항목 - 현재 프리뷰에서는 읽거나 전달하지 않습니다.
# 아래 값은 전부 주석입니다. 현재 웹 실행 때문에 발급받을 필요 없습니다.
# 필요한 별도 수집기를 준비한 경우에만 본인 .env에 추가합니다.
# 키를 적는 것만으로 원본 다운로드·주소 변환·분석 재계산이 실행되지 않습니다.

# 건축HUB 건축물대장정보: https://www.data.go.kr/data/15134735/openapi.do
# 회원가입·로그인 → 해당 서비스 활용신청 → 승인·서비스키 확인
# 발급값: 해당 서비스 사용 권한이 있는 서비스키. 상세 수집기는 Decoding 키 기준 준비.
# BUILDING_API_SERVICE_KEY=

# KOSIS 공유서비스: https://kosis.kr/openapi/index/index.jsp
# 로그인 → OPEN API 인증키 신청/활용신청 → 마이페이지에서 인증키 확인
# 발급값: KOSIS 공유서비스 인증키. 건축HUB 키나 SGIS Secret과 다릅니다.
# CSV/엑셀 다운로드로 분석하면 API 키를 준비하지 않아도 됩니다.
# KOSIS_API_KEY=

# SGIS 소지역 통계/경계: https://sgis.mods.go.kr/developer/html/main.html
# 발급값: 서비스 ID + 보안 Key(Secret). 임시 accessToken을 넣는 칸이 아닙니다.
# SGIS_CONSUMER_KEY=
# SGIS_CONSUMER_SECRET=

# 도로명주소 개발자센터: https://business.juso.go.kr/addrlink/openApi/apiReqst.do
# 서비스별 발급값: 검색 API 승인키 / 좌표제공 API 승인키(각각 별개)
# 현재 건물 검색은 포함된 자료 조회이므로 두 키를 사용하지 않습니다.
# JUSO_SEARCH_CONFIRM_KEY=
# JUSO_COORD_CONFIRM_KEY=
