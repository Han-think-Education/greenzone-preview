# 웹 실행 설정 + 발급받은 API 키 입력 예제
# 아래 신청 사이트에서 받은 값을 실제 .env의 같은 이름 오른쪽에 넣으세요.
# 분석 화면은 저장된 공식 자료를 사용합니다. VWorld 키는 웹의 영상 배경 연결에 사용하며, 나머지 자료 키는 원본 재수집·후속 연결용입니다.
# 신청·다운로드 상세 안내: docs/API_KEYS_AND_DATA.txt
# .env가 없을 때만 복사하세요. 기존 .env를 덮어쓰지 마세요.
# 실제 .env는 Git 업로드 금지
APP_ENV=development
APP_PORT=8000
# AI는 선택 기능입니다. 켜려면 실제 서버 주소와 모델 이름을 함께 확인하세요.
GREENZONE_AI_ENABLED=0
# Docker에서 호스트 모델 서버로 접근하는 예시. 직접 Python 실행은 실제 주소로 수정.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# 예시 모델입니다. AI를 켤 때 실제 설치 모델 이름을 확인하세요.
OLLAMA_MODEL=gemma4:e4b
OLLAMA_TIMEOUT_SECONDS=45
# ===== 공식 안내문 검색용 임베딩 (Ollama) =====
# 위 OLLAMA_MODEL은 질문 분류용, 아래 EMBEDDING_MODEL은 문서 검색용입니다.
# 문서 키워드 검색은 0에서도 동작합니다. Ollama 연결 준비 후 1로 바꾸세요.
GREENZONE_EMBEDDING_ENABLED=0
# 설치된 정확한 이름으로 수정. Ollama에 bge-m3:latest가 있을 때의 예시입니다.
EMBEDDING_MODEL=bge-m3:latest
# 비우면 OLLAMA_BASE_URL을 재사용합니다. Docker에서 호스트 서버는 host.docker.internal 주소.
EMBEDDING_OLLAMA_BASE_URL=
EMBEDDING_TIMEOUT_SECONDS=12
# 초기 유사도 기준입니다. 정답 확률이 아니며 실제 질의로 조정해야 합니다.
EMBEDDING_MIN_SCORE=0.55
# 모델 버전·양자화를 바꾸면 이 값을 올리고 문서를 다시 색인하세요.
EMBEDDING_REVISION=1

ADMIN_USERNAME=admin
# Docker의 관리 기능에는 12자 이상 암호 필요. 로컬 실행기는 비어 있으면 실행용 암호 발급.
ADMIN_PASSWORD=

# ADMIN_PASSWORD는 직접 정하는 관리자 암호입니다. API 발급키가 아닙니다.
# OLLAMA_*는 선택 AI 서버 설정입니다. 지도·데이터 API 키가 아닙니다.

# ===== 우선 준비: 건축물대장 + KOSIS 통계 =====
# 1. 건물 주소·용도·규모 등 분석 자료
# 사이트: 공공데이터포털
# 정확한 서비스명: 국토교통부_건축HUB_건축물대장정보 서비스
# 신청: https://www.data.go.kr/data/15134735/openapi.do
# 로그인 → 해당 서비스 활용신청 → 승인·서비스키 확인
# 넣을 값: 해당 서비스에 사용 권한이 있는 '서비스키'
# 예: BUILDING_API_SERVICE_KEY=발급받은_서비스키 (아래 빈칸에 실제 값만 입력)
BUILDING_API_SERVICE_KEY=

# 2. 지역별 인구·주거 등 통계 분석 자료
# 사이트: KOSIS 국가통계포털 공유서비스 (SGIS와 별도)
# 신청: https://kosis.kr/openapi/index/index.jsp
# 로그인 → 활용신청 → 마이페이지 → 활용신청현황
# 넣을 값: KOSIS에서 발급한 '인증키' (건축물대장 서비스키와 다름)
# 예: KOSIS_API_KEY=발급받은_인증키 (아래 빈칸에 실제 값만 입력)
KOSIS_API_KEY=

# ===== 선택: 해당 기능을 추가할 때만 신청 =====
# 위성·항공 배경 / VWorld 오픈API 인증키
# https://www.vworld.kr/ → 로그인 → 오픈API 인증키 신청
# 후속 확장 활용API 체크 추천은 docs/API_KEYS_AND_DATA.txt의 VWorld 항목 참고
# WMTS/TMS 권한을 선택한 'VWorld 오픈API 인증키'를 넣습니다.
# 일반지도는 키 없이 사용하며, 영상·도로명 겹치기는 아래 키를 사용합니다.
VWORLD_API_KEY=
# 선택: 등록한 서비스 URL을 명시할 때 입력. 비워 두면 현재 웹 주소 사용.
# 예: VWORLD_DOMAIN=http://localhost:8000/
VWORLD_DOMAIN=

# 소지역 통계·경계 / SGIS 서비스 ID와 보안 Key(Secret)
# https://sgis.mods.go.kr/developer/html/main.html → 로그인 → 서비스 키 발급
# SGIS_CONSUMER_KEY=
# SGIS_CONSUMER_SECRET=

# 일반 주소 검색·좌표 / 도로명주소 개발자센터에서 용도별 승인키 신청
# https://business.juso.go.kr/addrlink/openApi/apiReqst.do
# 검색 API에서 받은 승인키:
# JUSO_SEARCH_CONFIRM_KEY=
# 좌표제공 API에서 받은 승인키:
# JUSO_COORD_CONFIRM_KEY=

# 위 변수명은 그린존에서 사용할 설정 이름입니다. 발급 사이트의 화면 이름과 다를 수 있습니다.
# 선택 항목은 필요할 때 실제 .env에서 맨 앞 #를 지우고 값을 입력하세요.
# 실제 키는 이 .env.example에 저장하지 마세요. 기존 .env는 유지하고 필요한 줄만 추가하세요.
