# Copy-Item .env.example .env (실제 .env는 Git 업로드 금지)
APP_ENV=development
APP_PORT=8000
# Windows에 이미 실행 중인 Ollama 11435로 Docker 컨테이너에서 접근
OLLAMA_BASE_URL=http://host.docker.internal:11435
# 설치 모델 이름을 확인하고 이 값을 수정하세요:
# Invoke-RestMethod http://127.0.0.1:11435/api/tags
OLLAMA_MODEL=gemma4:e4b
OLLAMA_TIMEOUT_SECONDS=45
# 다음 단계 지도 구현 시 로컬 .env에만 추가
KAKAO_JAVASCRIPT_KEY=
KAKAO_REST_API_KEY=
